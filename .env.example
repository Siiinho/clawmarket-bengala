# Copie para ".env" e preencha quando ativar a Fase 2 (Supabase).
# Enquanto vazio, o app continua rodando 100% no localStorage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Busca opcional de imagens. Sem estas chaves, o backend usa o catálogo
# mercadológico configurado e fontes públicas por código exato.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# EAN Images (imagem e descrição por código de barras) — SÓ NO SERVIDOR.
# Nunca use o prefixo VITE_ aqui: isso colocaria a chave no código do navegador.
EANIMAGES_API_KEY=
# 0 = buscar só a imagem (1 crédito); 1 = imagem + nome/descrição (2 créditos), só na 1ª vez
EANIMAGES_COM_DADOS=1

# Site do encarte (link da tag NFC). Senha para publicar de fora da rede da loja.
# Vazio = só o PC do mercado e a rede local podem publicar.
ENCARTE_TOKEN=
# Pasta onde o encarte publicado e as fotos ficam guardados (padrão: dados/encarte)
ENCARTE_DIR=
